# ========= Backend (FastAPI) =========
# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Groq API (PRIMARY online LLM)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (OFFLINE fallback LLM)
# Must have Ollama running locally. Example: `ollama run llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings (local)
# HuggingFace embedding model cached locally on first run
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chroma persistent storage
CHROMA_PERSIST_DIR=/Users/faisalahmed/Desktop/SIH/data/chroma
CHROMA_COLLECTION=bis_chunks

# Retrieval gate / thresholds
RETRIEVAL_TOP_K=6
# If the best match is worse than this, refuse
# Note: tune on your eval set
RETRIEVAL_MAX_DISTANCE=0.55

# Chat behavior
TEMPERATURE=0.1
MAX_TOKENS=700

# Anti-hallucination gate behavior
# If enabled, always refuse when retrieved context is empty/low score
STRICT_RETRIEVAL_GATE=true

# ========= Frontend =========
# Next.js will use NEXT_PUBLIC_* values at build/runtime.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


