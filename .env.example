# Copy this file to .env and replace placeholders. Never commit .env.

# API and browser access
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_KEY=replace_with_a_local_secret_if_api_auth_is_enabled

# Primary online LLM (optional when using Ollama only)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Local offline LLM fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Local retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Paths are relative to the repository root (e.g. data/chroma).
# Legacy value: CHROMA_PERSIST_DIR=../data/chroma (relative to backend/ CWD)
CHROMA_DB_DIR=data/chroma
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=bis_standards
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=0.55
STRICT_RETRIEVAL_GATE=true

# Generation
TEMPERATURE=0.1
MAX_TOKENS=2048

# CPU throttling guard — limits numeric/tokenizer threads and serializes
# concurrent LLM calls so bursts never peg every core.
EMBEDDING_THREADS=2
MAX_CONCURRENT_GENERATIONS=2
PRELOAD_EMBEDDING_MODEL=true

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
