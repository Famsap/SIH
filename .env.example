# Copy this file to .env and replace placeholders. Never commit .env.

# API and browser access
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_KEY=replace_with_a_local_secret_if_api_auth_is_enabled

# Primary online LLM (optional when using Ollama only)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Local offline LLM fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Local retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_DB_DIR is an operator-facing alias; the current application reads CHROMA_PERSIST_DIR.
CHROMA_DB_DIR=../data/chroma
CHROMA_PERSIST_DIR=../data/chroma
CHROMA_COLLECTION=bis_chunks
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_DISTANCE=0.55
STRICT_RETRIEVAL_GATE=true

# Generation
TEMPERATURE=0.1
MAX_TOKENS=700

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
